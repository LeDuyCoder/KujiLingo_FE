# Optional local development quick-login account. Uses the regular /auth/login
# endpoint; use a dedicated dev account and never production credentials.
NEXT_PUBLIC_API_URL=https://your-render-service.onrender.com/api/v1
NEXT_PUBLIC_DEMO_USER_EMAIL=user_demo_1@example.com
NEXT_PUBLIC_DEMO_USER_PASSWORD=Password123
# Configure a separate local admin account for the admin quick-login button.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
# Same Web OAuth client ID configured as GOOGLE_CLIENT_ID in the backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
